{
  "name": "@dynosty/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include '../../packages/game-core/dist/**' --env-file-if-exists=../../.env.local src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env.local dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dynosty/game-core": "workspace:*",
    "fastify": "5.12.8",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
