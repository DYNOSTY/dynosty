{
  "name": "dynosty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26.13.1 <27",
    "pnpm": "12.18.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --filter @dynosty/game-core build && concurrently --kill-others --names core,api,web \"pnpm --filter @dynosty/game-core dev\" \"pnpm --filter @dynosty/api dev\" \"pnpm --filter @dynosty/web dev\"",
    "build": "pnpm --filter @dynosty/game-core build && pnpm --filter @dynosty/api build && pnpm --filter @dynosty/web build",
    "typecheck": "pnpm --filter @dynosty/game-core build && pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "pnpm --filter @dynosty/game-core build && vitest run",
    "test:e2e": "pnpm --filter @dynosty/game-core build && playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:up": "docker compose --env-file .env.local -f infra/compose.dev.yml up -d --wait",
    "db:down": "docker compose --env-file .env.local -f infra/compose.dev.yml down",
    "db:check": "node --env-file=.env.local scripts/check-db.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "concurrently": "10.0.7",
    "pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
